{
  "name": "pi-jev-skill-suggestion",
  "version": "0.1.0",
  "description": "Pi extension that removes the inlined skill list and asks TypeSafe Jev which skill to load",
  "license": "MIT",
  "type": "module",
  "author": "iamdin <iamdinq@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamdin/pi-jev-skill-suggestion.git"
  },
  "homepage": "https://github.com/iamdin/pi-jev-skill-suggestion#readme",
  "bugs": {
    "url": "https://github.com/iamdin/pi-jev-skill-suggestion/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "typesafe",
    "jev",
    "skills"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && bun scripts/check-strip.ts && bun scripts/check-router.ts",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "p-limit": "^7.3.3"
  }
}
