{
  "name": "pi-jev-skill-suggestion",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that routes skill selection through TypeSafe Jev instead of stuffing every skill into the system prompt.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "typesafe",
    "jev",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && bun scripts/check-strip.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
